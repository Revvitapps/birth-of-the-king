# All optional. The site runs with none of these set.

# Public base URL, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://birth-of-the-king.revvit.io

# "on" lets search engines index the site. Leave unset (noindex) until launch.
SITE_INDEXING=

# Access code buyers receive with the book. When unset, every lesson is open (prototype mode).
# When set, Lesson 1 stays free and Lessons 2 to 5 ask for the code once per device.
ACCESS_CODE=

# Store link for the "Get the Book" buttons (Payhip, Etsy, Amazon...). Unset shows a placeholder.
NEXT_PUBLIC_BUY_URL=

# Where new sign-ups (free Lesson 1 sample) are forwarded as JSON (Zapier, Make, Slack workflow, CRM).
PIPELINE_WEBHOOK_URL=
